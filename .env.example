# Base de datos PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/auth?schema=public"

# Clave para firmar las sesiones (JWT). Genera una con: openssl rand -base64 32
SESSION_SECRET="cambia-esto-por-una-clave-larga-y-aleatoria"

# URL pública de la app (usada en los correos y en los back_url de MercadoPago)
APP_URL="http://localhost:3000"

# MercadoPago (https://www.mercadopago.com/developers/panel/app)
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_WEBHOOK_SECRET=""
SUSCRIPCION_PRECIO="10000"
SUSCRIPCION_MONEDA="ARS"

# SMTP para el correo de recuperación de contraseña.
# Si se deja vacío, el enlace de recuperación se imprime en la consola del servidor.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Soporte <no-reply@example.com>"
CRON_SECRET=""
